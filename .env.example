# Firebase web app config — copy this file to .env.local and fill in the values
# from Firebase Console → Project settings → Your apps → Web app.
# Without these, the site still runs but accounts, solve history, and
# algorithm progress are disabled.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to connect to a local Firebase Auth emulator on 127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=

# WCA OAuth (verified account linking on the dashboard).
# Register an application at
# https://www.worldcubeassociation.org/oauth/applications with:
#   Redirect URI: <your site origin>/wca-callback  (e.g. http://localhost:3000/wca-callback)
#   Scopes: public
# and paste the Application ID here. Without it, WCA linking is hidden.
NEXT_PUBLIC_WCA_CLIENT_ID=
